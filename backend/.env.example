APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Use localhost when running scripts/API on the host (Docker Compose overrides
# hostnames to postgres/redis inside the api and worker containers).
DATABASE_URL=postgresql+asyncpg://recipe_finder:recipe_finder@localhost:5432/recipe_finder
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$
OPENAI_API_KEY=
# Explicit opt-in: cookbook text, pantry notes, and images may be sent to this provider.
EXTERNAL_AI_ENABLED=false
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# Free key from https://api.data.gov/signup/ — optional; seed macros work without it.
USDA_FDC_API_KEY=
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
NUTRITION_MIN_COVERAGE=0.6
DEV_SYNC_INGESTION=true
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_HOUR=5
PANTRY_AI_RATE_LIMIT_PER_HOUR=30
LLM_DAILY_CALL_LIMIT=1000
MAX_ACTIVE_INGESTIONS_PER_USER=1
MAX_PDF_PAGES=1000
MAX_PDF_TEXT_CHARS=10000000
MAX_EPUB_ENTRIES=2000
MAX_EPUB_ENTRY_BYTES=8388608
MAX_EPUB_UNCOMPRESSED_BYTES=262144000
MAX_INGESTION_LLM_CHUNKS=100
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=10000
